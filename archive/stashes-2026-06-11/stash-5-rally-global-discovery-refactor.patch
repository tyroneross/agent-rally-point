+pub(super) fn execute_locate(command: LocateCommand) -> Result<WriteOutput, CliError> {
+    let home = home_dir("locate")?;
+    let located = locate_event(&home, &command.identifier).map_err(|err| {
+        CliError::runtime("locate", format!("failed to scan Rally channels: {err}"))
+    })?;
+    let Some(located) = located else {
+        return Err(CliError::not_found(
+            "locate",
+            format!(
+                "event {} was not found in local Rally channels",
+                command.identifier
+            ),
+        ));
+    };
+    let text = format!(
+        "{} repo={} channel={} kind={}: {}",
+        located.event.event.event_id,
+        event_repo_name(&located.event),
+        located.event.channel.channel_dir,
+        located.event.event.kind,
+        located.event.event.subject
+    );
+    Ok(WriteOutput {
+        json: command.common.json,
+        text,
+        body: json!({
+            "ok": true,
+            "command": "locate",
+            "schema": "agent-rally.command.locate.v1",
+            "channel": located.event.channel.channel_dir,
+            "data": {
+                "located": located.event,
+                "warnings": located.warnings,
+            }
+        }),
+    })
+}
