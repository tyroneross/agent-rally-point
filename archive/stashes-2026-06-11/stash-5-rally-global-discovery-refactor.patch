+fn toml_table_bounds(lines: &[String], table: &str) -> Option<(usize, usize)> {
+    let header = format!("[{table}]");
+    let start = lines
+        .iter()
+        .position(|line| toml_header(line).as_deref() == Some(header.as_str()))?;
+    let end = lines
+        .iter()
+        .enumerate()
+        .skip(start + 1)
+        .find(|(_, line)| toml_header(line).is_some())
+        .map(|(index, _)| index)
+        .unwrap_or(lines.len());
+    Some((start, end))
+}
+
+fn toml_header(line: &str) -> Option<String> {
+    let trimmed = line.split('#').next().unwrap_or("").trim();
+    if trimmed.starts_with('[') && trimmed.ends_with(']') && !trimmed.starts_with("[[") {
