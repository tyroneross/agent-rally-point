+pub(super) fn execute_recent(command: RecentCommand) -> Result<WriteOutput, CliError> {
+    if !command.all {
+        return Err(CliError::usage(
+            "recent",
+            "recent currently requires --all to scan local Rally channels",
+        ));
+    }
+    let home = home_dir("recent")?;
+    let recent = recent_events(&home, command.limit).map_err(|err| {
+        CliError::runtime("recent", format!("failed to scan Rally channels: {err}"))
+    })?;
+    let text = if recent.events.is_empty() {
+        "No events across local Rally channels.".to_string()
+    } else {
+        recent
+            .events
+            .iter()
+            .map(|event| {
+                let time = event.event.time.as_deref().unwrap_or("unknown-time");
+                let tool = event.event.tool.as_deref().unwrap_or("unknown");
+                format!(
+                    "{} repo={} {} {} {}: {}",
+                    time,
+                    event_repo_name(event),
+                    event.event.event_id,
+                    event.event.kind,
+                    tool,
+                    event.event.subject
+                )
+            })
+            .collect::<Vec<_>>()
+            .join("\n")
+    };
+    Ok(WriteOutput {
+        json: command.common.json,
+        text,
+        body: json!({
+            "ok": true,
+            "command": "recent",
+            "schema": "agent-rally.command.recent.v1",
+            "channel": "all",
+            "data": {
+                "events": recent.events,
+                "warnings": recent.warnings,
+            }
+        }),
+    })
+}
