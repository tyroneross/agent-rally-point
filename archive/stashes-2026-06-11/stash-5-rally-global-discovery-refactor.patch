+fn write_install_many(store: &ChannelStore, tools: &[&str]) -> Result<AdapterInstall, CliError> {
+    let mut installs = Vec::new();
+    for tool in tools {
+        let install = if matches!(*tool, "cmux" | "herdr") {
+            write_adapter_install(store, tool)?
+        } else {
+            write_tool_install(tool)?
+        };
+        installs.push(install);
+    }
+    Ok(combine_installs(installs))
+}
+
+fn combine_installs(installs: Vec<AdapterInstall>) -> AdapterInstall {
+    let mut files = Vec::new();
+    let mut backup_paths = Vec::new();
+    let mut primary_path = None;
+    for install in installs {
+        if primary_path.is_none() {
+            primary_path = install.primary_path;
+        }
+        extend_unique(&mut files, install.files);
+        extend_unique(&mut backup_paths, install.backup_paths);
+    }
+    AdapterInstall {
+        primary_path,
+        files,
+        modified_config: None,
+        backup_paths,
+    }
+}
+
+fn extend_unique(target: &mut Vec<String>, values: Vec<String>) {
+    for value in values {
+        if !target.contains(&value) {
+            target.push(value);
+        }
+    }
+}
