+        let mut next = text.to_string();
+        if !next.is_empty() && !next.ends_with('\n') {
+            next.push('\n');
+        }
+        if !next.is_empty() {
+            next.push('\n');
+        }
+        next.push_str(&format!("[{table}]\n{key} = true\n"));
+        return next;
+    };
+    let key_index = lines[start + 1..end]
