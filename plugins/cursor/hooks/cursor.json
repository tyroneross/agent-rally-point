{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "RALLY_HOOK_SOURCE=plugin RALLY_HOOK_HOST_TIMEOUT_MS=30000 bash \"${CURSOR_PLUGIN_ROOT}/hooks/rally-coordination-hook.sh\" start cursor",
        "timeout": 30
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "RALLY_HOOK_SOURCE=plugin RALLY_HOOK_HOST_TIMEOUT_MS=30000 bash \"${CURSOR_PLUGIN_ROOT}/hooks/rally-coordination-hook.sh\" idle cursor",
        "timeout": 30
      }
    ],
    "preToolUse": [
      {
        "command": "RALLY_HOOK_SOURCE=plugin RALLY_HOOK_HOST_TIMEOUT_MS=10000 bash \"${CURSOR_PLUGIN_ROOT}/hooks/rally-coordination-hook.sh\" before-write cursor",
        "timeout": 10,
        "matcher": "Write|Edit|StrReplace|Delete|EditNotebook"
      }
    ],
    "stop": [
      {
        "command": "RALLY_HOOK_SOURCE=plugin RALLY_HOOK_HOST_TIMEOUT_MS=30000 bash \"${CURSOR_PLUGIN_ROOT}/hooks/rally-coordination-hook.sh\" after-write cursor",
        "timeout": 30
      }
    ]
  }
}
