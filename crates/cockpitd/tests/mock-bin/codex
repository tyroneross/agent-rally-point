#!/usr/bin/env sh
# Mock `codex` binary for cockpitd adapter tests.
#
# Emits a representative JSONL sequence to stdout and exits:
#   1. session_started  — carries a mock session_id
#   2. message          — assistant turn ("Hello from mock Codex")
#   3. tool_call        — read_file (on the conservative allowlist, no G1 gate)
#   4. tool_result      — output of the tool
#   5. approval_request — native approval request (H1b: id is a valid UUID)
#   6. message          — follow-up assistant message (after gate resolves)
#   7. completed        — exit_code:0 (terminal)
#
# tool_call uses "read_file" which is on the conservative allowlist so it
# passes through the G1 authz gate without requiring approval. The
# approval_request at item 5 is the only gate (H1b native gate).
#
# Ignores all arguments; drains stdin; writes to stdout only.
# Does NOT invoke real codex — no credits burned.

# Drain stdin.
if [ ! -t 0 ]; then
  cat > /dev/null &
fi

# 1. session_started
printf '{"type":"session_started","session_id":"mock-codex-session-456"}\n'

# 2. message
printf '{"type":"message","role":"assistant","content":"Hello from mock Codex"}\n'

# 3. tool_call — read_file is on the conservative allowlist, passes G1
printf '{"type":"tool_call","id":"tc_001","tool":"read_file","args":{"path":"/tmp/test.txt"}}\n'

# 4. tool_result
printf '{"type":"tool_result","tool_call_id":"tc_001","output":"file1.txt\nfile2.txt"}\n'

# 5. approval_request — H1b: id must be a valid UUID for the wire round-trip gate
printf '{"type":"approval_request","id":"a1b2c3d4-0000-0000-0000-000000000001","tool":"shell","args":{"command":"rm -rf /important"}}\n'

# 6. follow-up message
printf '{"type":"message","role":"assistant","content":"Done with all tasks."}\n'

# 7. completed
printf '{"type":"completed","exit_code":0}\n'
