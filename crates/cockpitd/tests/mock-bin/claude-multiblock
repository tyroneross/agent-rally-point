#!/usr/bin/env sh
# Mock `claude` binary that emits a single assistant turn with:
#   1. system/init
#   2. assistant: ONE message with { text block + two tool_use blocks }
#   3. result (terminal)
#
# Used by G2 e2e test: asserts that 3 AdapterEvents flow from a single turn.

if [ ! -t 0 ]; then
  cat > /dev/null &
fi

# 1. system/init
printf '{"type":"system","subtype":"init","session_id":"mock-multiblock-session","tools":[]}\n'

# 2. assistant with text + two tool_use blocks in ONE message
printf '{"type":"assistant","message":{"id":"msg_mb","type":"message","role":"assistant","content":[{"type":"text","text":"I will read then write."},{"type":"tool_use","id":"t1","name":"read_file","input":{"path":"/tmp/a"}},{"type":"tool_use","id":"t2","name":"write_file","input":{"path":"/tmp/b","content":"hello"}}],"model":"claude-mock","stop_reason":"tool_use"}}\n'

# 3. result (terminal)
printf '{"type":"result","subtype":"success","is_error":false,"result":"done","session_id":"mock-multiblock-session","cost_usd":0,"duration_ms":10,"num_turns":1}\n'
