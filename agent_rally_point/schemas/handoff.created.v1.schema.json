{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-rally-point:schema:handoff.created.v1",
  "title": "Agent Rally Point handoff.created payload v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["from_tool", "to_tool"],
  "properties": {
    "id": { "type": "string", "description": "Caller-visible handoff id when supplied by a consumer." },
    "from_tool": { "type": "string" },
    "to_tool": { "type": "string" },
    "subject": { "type": "string" },
    "work_item": { "type": "string" },
    "requires_ack": { "type": "boolean" },
    "deadline_ts": { "type": "number" },
    "ref_commit": { "type": "string" },
    "ref_files": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "string" }
  }
}
