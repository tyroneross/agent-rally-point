{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-rally2:command:say:v1",
  "title": "Rally 2 Say Command",
  "type": "object",
  "required": ["ok", "product", "command", "schema", "data"],
  "properties": {
    "ok": { "const": true },
    "product": { "const": "rally2" },
    "command": { "const": "say" },
    "schema": { "const": "agent-rally2.command.say.v1" },
    "data": {
      "type": "object",
      "required": ["fact", "room"],
      "properties": {
        "fact": {
          "type": "object",
          "required": ["schema", "event_id", "thread_id", "created_at", "tool", "kind", "subject", "scope", "evidence", "origin", "trust_status"]
        },
        "room": { "type": "object" }
      }
    }
  }
}
