{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-rally:command:room:v1",
  "title": "Rally Room Command",
  "type": "object",
  "required": ["ok", "product", "command", "schema", "data"],
  "properties": {
    "ok": { "const": true },
    "product": { "const": "rally" },
    "command": { "const": "room" },
    "schema": { "const": "agent-rally.command.room.v1" },
    "data": {
      "type": "object",
      "required": ["query", "room"],
      "properties": {
        "query": {
          "type": "object",
          "required": ["paths"]
        },
        "agent_injectability": {
          "type": "array",
          "description": "Per-visible-agent live-injection readiness. Presence-only agents are not live-injectable; managed live/unknown sessions are.",
          "items": {
            "type": "object",
            "required": ["tool", "injectable", "status"],
            "properties": {
              "tool": { "type": "string" },
              "injectable": { "type": "boolean" },
              "status": { "type": "string" },
              "via": { "type": "string" },
              "session_id": { "type": "string" },
              "target": { "type": "string" },
              "reason": { "type": "string" }
            }
          }
        },
        "room": {
          "type": "object",
          "required": ["active_claims", "active_blockers", "open_handoffs", "current_decisions", "current_risks", "recent_artifacts", "unconsumed_artifacts", "stale_facts", "squads", "lead"],
          "properties": {
            "squads": {
              "type": "array",
              "description": "Distinct tools that have entered or authored facts. Each row carries freshness (fresh = heartbeat inside its adaptive presence window, stale = past it, unknown = unparseable last_seen_ts) with age_secs and window_secs. Advisory: a stale row is still visible and still a legal handoff target.",
              "items": {
                "type": "object",
                "required": ["tool", "last_seen_seq", "last_seen_ts", "status", "acknowledged", "window_secs", "freshness"],
                "properties": {
                  "tool": { "type": "string" },
                  "last_seen_seq": { "type": "integer" },
                  "last_seen_ts": { "type": "string" },
                  "status": { "type": "string", "enum": ["active", "idle"] },
                  "acknowledged": { "type": "boolean" },
                  "age_secs": { "type": "integer" },
                  "window_secs": { "type": "integer" },
                  "freshness": { "type": "string", "enum": ["fresh", "stale", "unknown"] }
                }
              }
            },
            "lead": { "type": ["string", "null"] },
            "system_health": {
              "type": "array",
              "description": "System-generated health/telemetry facts (external-intake, unmanaged-agent, duplicate-active-squad-id, binary-drift), split out of current_risks. Omitted when empty."
            }
          }
        }
      }
    }
  }
}
