{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-rally:command:room:v1",
  "title": "Rally Room Command",
  "type": "object",
  "required": ["ok", "product", "command", "schema", "data"],
  "properties": {
    "ok": { "const": true },
    "product": { "const": "rally" },
    "command": { "const": "room" },
    "schema": { "const": "agent-rally.command.room.v1" },
    "data": {
      "type": "object",
      "required": ["query", "room"],
      "properties": {
        "query": {
          "type": "object",
          "required": ["paths"]
        },
        "agent_injectability": {
          "type": "array",
          "description": "Per-visible-agent live-injection readiness. Presence-only agents are not live-injectable; managed live/unknown sessions are.",
          "items": {
            "type": "object",
            "required": ["tool", "injectable", "status"],
            "properties": {
              "tool": { "type": "string" },
              "injectable": { "type": "boolean" },
              "status": { "type": "string" },
              "via": { "type": "string" },
              "session_id": { "type": "string" },
              "target": { "type": "string" },
              "reason": { "type": "string" }
            }
          }
        },
        "room": {
          "type": "object",
          "required": ["active_claims", "active_blockers", "open_handoffs", "current_decisions", "current_risks", "recent_artifacts", "unconsumed_artifacts", "stale_facts", "squads", "lead"],
          "properties": {
            "squads": { "type": "array" },
            "lead": { "type": ["string", "null"] },
            "system_health": {
              "type": "array",
              "description": "System-generated health/telemetry facts (external-intake, unmanaged-agent, duplicate-active-squad-id, binary-drift), split out of current_risks. Omitted when empty."
            }
          }
        }
      }
    }
  }
}
