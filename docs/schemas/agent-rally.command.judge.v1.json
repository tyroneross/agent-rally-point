{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-rally-point.local/schemas/agent-rally.command.judge.v1.json",
  "title": "Rally judge command",
  "type": "object",
  "required": ["ok", "command", "schema", "channel", "data"],
  "properties": {
    "ok": { "const": true },
    "command": { "const": "judge" },
    "schema": { "const": "agent-rally.command.judge.v1" },
    "channel": { "type": "string" },
    "data": {
      "type": "object",
      "required": ["judgment"],
      "properties": {
        "judgment": {
          "type": "object",
          "required": ["allow", "fail_open_requested", "decision", "severity", "safe_to_write", "context_stale", "new_events_since_cursor", "reasons", "required_actions"],
          "properties": {
            "allow": { "type": "boolean" },
            "fail_open_requested": { "type": "boolean" },
            "decision": { "enum": ["continue", "pause", "ack_handoff", "refresh_context"] },
            "severity": { "enum": ["ok", "warn", "stop"] },
            "safe_to_write": { "type": "boolean" },
            "context_stale": { "type": "boolean" },
            "new_events_since_cursor": { "type": "integer" },
            "resource": { "type": ["string", "null"] },
            "auto_claimed": { "type": ["string", "null"] },
            "reasons": { "type": "array", "items": { "type": "object" } },
            "required_actions": { "type": "array", "items": { "type": "string" } },
            "pending_handoffs": { "type": "array", "items": { "type": "object" } },
            "claim_conflicts": { "type": "array", "items": { "type": "object" } }
          }
        }
      }
    }
  }
}
