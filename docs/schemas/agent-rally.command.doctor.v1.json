{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-rally-point.local/schemas/agent-rally.command.doctor.v1.json",
  "title": "Rally doctor command",
  "type": "object",
  "required": ["ok", "command", "schema", "channel", "data"],
  "properties": {
    "ok": { "const": true },
    "command": { "const": "doctor" },
    "schema": { "const": "agent-rally.command.doctor.v1" },
    "channel": { "type": "string" },
    "data": {
      "type": "object",
      "required": ["doctor"],
      "properties": {
        "doctor": {
          "type": "object",
          "required": ["status", "enforcement", "findings", "checkpoint", "installed_tools"],
          "properties": {
            "status": { "enum": ["pass", "warn", "fail"] },
            "tool": { "type": ["string", "null"] },
            "enforcement": { "enum": ["off", "warn", "strict"] },
            "findings": { "type": "array", "items": { "type": "object" } },
            "checkpoint": { "type": "object" },
            "installed_tools": { "type": "array", "items": { "type": "object" } }
          }
        }
      }
    }
  }
}
