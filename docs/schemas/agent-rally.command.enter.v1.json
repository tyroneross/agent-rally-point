{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-rally:command:enter:v1",
  "title": "Rally Enter Command",
  "type": "object",
  "required": ["ok", "product", "command", "schema", "data"],
  "properties": {
    "ok": { "const": true },
    "product": { "const": "rally" },
    "command": { "const": "enter" },
    "schema": { "const": "agent-rally.command.enter.v1" },
    "data": {
      "type": "object",
      "required": ["enter", "room"],
      "properties": {
        "enter": {
          "type": "object",
          "required": ["tool", "cursor", "entry", "attention", "attention_total", "attention_emitted", "attention_omitted"],
          "properties": {
            "tool": { "type": "string" },
            "session_id": { "type": "string" },
            "room_id": { "type": "string" },
            "cursor": { "type": "object" },
            "entry": {
              "type": "object",
              "required": ["do", "do_not", "know", "verify", "respond_to", "ignore"]
            },
            "attention": { "type": "array", "maxItems": 128 },
            "attention_total": { "type": "integer", "minimum": 0 },
            "attention_emitted": { "type": "integer", "minimum": 0, "maximum": 128 },
            "attention_omitted": { "type": "integer", "minimum": 0 }
          }
        },
        "room": { "type": "object" }
      }
    }
  }
}
