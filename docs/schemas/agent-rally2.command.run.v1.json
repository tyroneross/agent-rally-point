{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-rally2:command:run:v1",
  "title": "Rally 2 Run Command",
  "type": "object",
  "required": ["ok", "product", "command", "schema", "data"],
  "properties": {
    "ok": { "const": true },
    "product": { "const": "rally2" },
    "command": { "const": "run" },
    "schema": { "const": "agent-rally2.command.run.v1" },
    "data": {
      "type": "object",
      "required": ["mode", "session", "commands"],
      "properties": {
        "mode": { "type": "string" },
        "session": {
          "type": "object",
          "required": [
            "session_id",
            "name",
            "agent",
            "tool",
            "backend",
            "cwd",
            "target"
          ]
        },
        "commands": { "type": "object" }
      }
    }
  }
}
