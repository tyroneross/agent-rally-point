{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-rally:command:run:v1",
  "title": "Rally Run Command",
  "type": "object",
  "required": ["ok", "product", "command", "schema", "data"],
  "properties": {
    "ok": { "const": true },
    "product": { "const": "rally" },
    "command": { "const": "run" },
    "schema": { "const": "agent-rally.command.run.v1" },
    "data": {
      "type": "object",
      "required": ["run"],
      "properties": {
        "run": {
          "type": "object",
          "required": ["mode", "session", "commands"],
          "properties": {
            "mode": { "type": "string" },
            "session": {
              "type": "object",
              "required": [
                "session_id",
                "name",
                "agent",
                "tool",
                "backend",
                "cwd",
                "target"
              ],
              "properties": {
                "task_scoped": {
                  "type": "boolean",
                  "description": "True when the managed process owns one prompt and exits naturally after that prompt completes. Omitted for persistent interactive sessions."
                },
                "task_id": {
                  "type": "string",
                  "description": "Unique bounded-run id used to retain one final result even when a session name is reused."
                }
              }
            },
            "commands": { "type": "object" }
          }
        }
      }
    }
  }
}
