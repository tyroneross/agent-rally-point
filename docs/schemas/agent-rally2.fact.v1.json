{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-rally2:fact:v1",
  "title": "Rally 2 Fact",
  "type": "object",
  "required": [
    "schema",
    "event_id",
    "thread_id",
    "created_at",
    "tool",
    "kind",
    "subject",
    "scope",
    "evidence",
    "origin",
    "trust_status"
  ],
  "properties": {
    "schema": { "const": "agent-rally2.fact.v1" },
    "event_id": { "type": "string" },
    "thread_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "tool": { "type": "string" },
    "role": { "type": ["string", "null"] },
    "kind": {
      "enum": [
        "claim",
        "release",
        "blocker",
        "resolve",
        "decision",
        "artifact",
        "handoff",
        "risk",
        "lesson"
      ]
    },
    "subject": { "type": "string" },
    "scope": {
      "type": "array",
      "items": { "type": "string" }
    },
    "summary": { "type": ["string", "null"] },
    "evidence": {
      "type": "array",
      "items": { "type": "string" }
    },
    "target": { "type": ["string", "null"] },
    "ref": { "type": ["string", "null"] },
    "status": { "type": ["string", "null"] },
    "severity": { "type": ["string", "null"] },
    "uri": { "type": ["string", "null"] },
    "origin": { "type": "string" },
    "trust_status": { "type": "string" }
  }
}
