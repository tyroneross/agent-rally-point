{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-rally:command:adopt:v1",
  "title": "Rally Adopt Command",
  "type": "object",
  "required": ["ok", "product", "command", "schema", "data"],
  "properties": {
    "ok": { "const": true },
    "product": { "const": "rally" },
    "command": { "const": "adopt" },
    "schema": { "const": "agent-rally.command.adopt.v1" },
    "data": {
      "type": "object",
      "required": ["adopt"],
      "properties": {
        "adopt": {
          "type": "object",
          "required": ["session"],
          "properties": {
            "session": {
              "type": "object",
              "required": [
                "session_id",
                "name",
                "agent",
                "tool",
                "backend",
                "cwd",
                "target"
              ]
            }
          }
        }
      }
    }
  }
}
