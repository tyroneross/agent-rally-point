{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-rally:command:session:v1",
  "title": "Rally Session Lease Command",
  "type": "object",
  "required": ["ok", "product", "command", "schema", "data"],
  "properties": {
    "ok": { "const": true },
    "product": { "const": "rally" },
    "command": { "const": "session" },
    "schema": { "const": "agent-rally.command.session.v1" },
    "data": {
      "type": "object",
      "required": ["session"],
      "properties": {
        "session": {
          "oneOf": [
            {
              "type": "object",
              "required": ["action", "lease", "environment", "shell_export", "daemon"],
              "properties": {
                "action": { "const": "ensure" },
                "lease": {
                  "type": "object",
                  "required": ["raw_session_id", "session_id", "endpoint_id", "tool", "adapter", "reused", "capabilities"],
                  "properties": {
                    "raw_session_id": { "type": "string" },
                    "session_id": { "type": "string" },
                    "endpoint_id": { "type": "string" },
                    "tool": { "type": "string" },
                    "adapter": { "type": "string" },
                    "reused": { "type": "boolean" },
                    "capabilities": {
                      "type": "object",
                      "required": ["identity", "visibility", "blocking", "atomic_claims", "lifecycle_close", "delivery"],
                      "additionalProperties": false,
                      "properties": {
                        "identity": { "$ref": "#/$defs/capability" },
                        "visibility": { "$ref": "#/$defs/capability" },
                        "blocking": { "$ref": "#/$defs/capability" },
                        "atomic_claims": { "$ref": "#/$defs/capability" },
                        "lifecycle_close": { "$ref": "#/$defs/capability" },
                        "delivery": { "$ref": "#/$defs/capability" }
                      }
                    }
                  }
                },
                "environment": {
                  "type": "object",
                  "required": ["RALLY_SESSION_ID", "RALLY_AGENT_ID", "RALLY_TOOL_ID"],
                  "additionalProperties": { "type": "string" }
                },
                "shell_export": { "type": "string" },
                "daemon": { "$ref": "#/$defs/daemon_status" }
              }
            },
            {
              "type": "object",
              "required": ["action", "tool", "session_id", "released_claim_ids", "close_fact"],
              "properties": {
                "action": { "const": "close" },
                "tool": { "type": "string" },
                "session_id": { "type": "string" },
                "released_claim_ids": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "close_fact": { "type": "object" }
              }
            },
            {
              "type": "object",
              "required": ["action", "sessions", "total", "emitted", "omitted", "fresh", "stale", "unknown", "window_secs", "history_command"],
              "properties": {
                "action": { "const": "current" },
                "sessions": {
                  "type": "array",
                  "maxItems": 128,
                  "items": { "$ref": "#/$defs/current_session" }
                },
                "total": { "type": "integer", "minimum": 0 },
                "emitted": { "type": "integer", "minimum": 0, "maximum": 128 },
                "omitted": { "type": "integer", "minimum": 0 },
                "fresh": { "type": "integer", "minimum": 0 },
                "stale": { "type": "integer", "minimum": 0 },
                "unknown": { "type": "integer", "minimum": 0 },
                "window_secs": { "type": "integer", "minimum": 1 },
                "history_command": { "type": "string" }
              }
            },
            {
              "type": "object",
              "required": ["action", "transitions", "total", "emitted", "omitted", "limit"],
              "properties": {
                "action": { "const": "history" },
                "transitions": {
                  "type": "array",
                  "maxItems": 100,
                  "items": { "$ref": "#/$defs/session_transition" }
                },
                "total": { "type": "integer", "minimum": 0 },
                "emitted": { "type": "integer", "minimum": 0, "maximum": 100 },
                "omitted": { "type": "integer", "minimum": 0 },
                "limit": { "type": "integer", "minimum": 1, "maximum": 100 }
              }
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "capability": {
      "type": "string",
      "enum": ["enforced", "advisory", "unmanaged"]
    },
    "daemon_status": {
      "type": "object",
      "required": ["activation", "live"],
      "properties": {
        "activation": {
          "type": "string",
          "enum": ["not_needed", "disabled", "already_running", "started", "failed"]
        },
        "live": { "type": "boolean" },
        "pid": { "type": "integer", "minimum": 1 },
        "socket": { "type": "string" },
        "detail": { "type": "string" }
      }
    },
    "current_session": {
      "type": "object",
      "required": ["tool", "session_id", "adapter", "capabilities", "started_at", "last_seen_at", "last_seen_seq", "freshness"],
      "properties": {
        "tool": { "type": "string" },
        "session_id": { "type": "string" },
        "adapter": { "type": "string" },
        "capabilities": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/capability" }
        },
        "started_at": { "type": "string" },
        "last_seen_at": { "type": "string" },
        "last_seen_seq": { "type": "integer", "minimum": 0 },
        "age_secs": { "type": "integer", "minimum": 0 },
        "freshness": { "type": "string", "enum": ["fresh", "stale", "unknown"] }
      }
    },
    "session_transition": {
      "type": "object",
      "required": ["state", "event_id", "seq", "at", "tool", "session_id"],
      "properties": {
        "state": { "type": "string", "enum": ["active", "closed"] },
        "event_id": { "type": "string" },
        "seq": { "type": "integer", "minimum": 0 },
        "at": { "type": "string" },
        "tool": { "type": "string" },
        "session_id": { "type": "string" },
        "adapter": { "type": "string" },
        "capabilities": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/capability" }
        }
      }
    }
  }
}
