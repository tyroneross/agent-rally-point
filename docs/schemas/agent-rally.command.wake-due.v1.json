{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-rally.command.wake-due.v1",
  "title": "rally wake-due response",
  "description": "B4: trust-gated wake eligibility projection. Lists standby facts whose wake_after has passed. Emits suggested_command strings only — rally never executes anything.",
  "type": "object",
  "properties": {
    "ok": { "type": "boolean" },
    "product": { "type": "string", "const": "rally" },
    "command": { "type": "string", "const": "wake-due" },
    "schema": { "type": "string", "const": "agent-rally.command.wake-due.v1" },
    "data": {
      "type": "object",
      "required": ["wake-due"],
      "properties": {
        "wake-due": {
          "type": "object",
          "required": ["due"],
          "properties": {
            "due": {
              "type": "array",
              "description": "Standbys whose wake_after has passed and whose owner is a known room participant.",
              "items": {
                "type": "object",
                "properties": {
                  "standby_event_id": { "type": "string" },
                  "owner": { "type": ["string", "null"] },
                  "reason": { "type": ["string", "null"] },
                  "wake_after": { "type": "string" },
                  "suggested_command": { "type": "string" }
                },
                "required": ["standby_event_id", "wake_after", "suggested_command"]
              }
            }
          }
        }
      }
    }
  },
  "required": ["ok", "command", "schema", "data"]
}
