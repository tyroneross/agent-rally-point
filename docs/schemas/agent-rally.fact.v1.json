{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-rally:fact:v1",
  "title": "Rally Fact",
  "type": "object",
  "required": [
    "schema",
    "event_id",
    "thread_id",
    "created_at",
    "tool",
    "kind",
    "subject",
    "scope",
    "evidence"
  ],
  "properties": {
    "schema": { "const": "agent-rally.fact.v1" },
    "event_id": { "type": "string" },
    "thread_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "tool": { "type": "string" },
    "role": { "type": ["string", "null"] },
    "kind": {
      "enum": [
        "claim",
        "release",
        "blocker",
        "resolve",
        "decision",
        "artifact",
        "handoff",
        "risk",
        "lesson",
        "session",
        "wake",
        "presence",
        "claim.expired",
        "read",
        "backlog_item",
        "receipt",
        "standby",
        "mission",
        "unknown"
      ]
    },
    "subject": { "type": "string" },
    "scope": {
      "type": "array",
      "items": { "type": "string" }
    },
    "summary": { "type": ["string", "null"] },
    "evidence": {
      "type": "array",
      "items": { "type": "string" }
    },
    "target": { "type": ["string", "null"] },
    "ref": { "type": ["string", "null"] },
    "status": { "type": ["string", "null"] },
    "severity": { "type": ["string", "null"] },
    "uri": { "type": ["string", "null"] },
    "session": { "type": ["object", "null"] }
  }
}
