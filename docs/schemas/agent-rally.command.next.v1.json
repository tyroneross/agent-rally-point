{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-rally-point.local/schemas/agent-rally.command.next.v1.json",
  "title": "Rally next command",
  "type": "object",
  "required": ["ok", "command", "schema", "channel", "data"],
  "properties": {
    "ok": { "const": true },
    "command": { "const": "next" },
    "schema": { "const": "agent-rally.command.next.v1" },
    "channel": { "type": "string" },
    "data": {
      "type": "object",
      "required": ["next"],
      "properties": {
        "next": {
          "type": "object",
          "required": ["action_kind", "target_event_id", "subject", "reasoning", "source_event_ids", "score", "factors", "agent_visible", "alternatives"],
          "properties": {
            "action_kind": { "type": "string" },
            "target_event_id": { "type": ["string", "null"] },
            "subject": { "type": "string" },
            "reasoning": { "type": "array", "items": { "type": "string" } },
            "source_event_ids": { "type": "array", "items": { "type": "string" } },
            "score": { "type": "number" },
            "factors": { "type": "object" },
            "agent_visible": { "type": "object" },
            "alternatives": { "type": "array", "items": { "type": "object" } }
          }
        }
      }
    }
  }
}
