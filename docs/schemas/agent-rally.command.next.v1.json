{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-rally:command:next:v1",
  "title": "Rally Next Command",
  "type": "object",
  "required": ["ok", "product", "command", "schema", "data"],
  "properties": {
    "ok": {
      "const": true
    },
    "product": {
      "const": "rally"
    },
    "command": {
      "const": "next"
    },
    "schema": {
      "const": "agent-rally.command.next.v1"
    },
    "data": {
      "type": "object",
      "required": ["tool", "next", "wake_intent", "room"],
      "properties": {
        "tool": {
          "type": "string"
        },
        "role": {
          "type": ["string", "null"]
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next": {
          "type": "object",
          "required": [
            "mode",
            "action",
            "actionable",
            "reason",
            "score",
            "confidence",
            "requires_human",
            "stop_reason",
            "target_event_id",
            "source_event_ids",
            "suggested_claims",
            "suggested_commands",
            "completion",
            "waiting_on",
            "alternatives"
          ],
          "properties": {
            "mode": {
              "type": "string"
            },
            "action": {
              "type": "string"
            },
            "actionable": {
              "type": "boolean"
            },
            "reason": {
              "type": "string"
            },
            "score": {
              "type": "integer"
            },
            "confidence": {
              "type": "number"
            },
            "requires_human": {
              "type": "boolean"
            },
            "stop_reason": {
              "type": ["string", "null"]
            },
            "target_event_id": {
              "type": ["string", "null"]
            },
            "source_event_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "fact": {
              "type": ["object", "null"]
            },
            "suggested_claims": {
              "type": "array"
            },
            "suggested_commands": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "completion": {
              "type": "object"
            },
            "waiting_on": {
              "type": "array"
            },
            "alternatives": {
              "type": "array"
            },
            "peer_targets": {
              "type": "object",
              "description": "Visible peers ranked freshest-first (fresh -> unknown -> stale, youngest age first, self excluded) for choosing a handoff target. Advisory: a stale peer is still a legal --target. Counts cover the whole room; ranked is a capped shortlist and truncated says how many were cut.",
              "required": ["fresh", "stale", "unknown", "ranked", "truncated"],
              "properties": {
                "fresh": { "type": "integer" },
                "stale": { "type": "integer" },
                "unknown": { "type": "integer" },
                "truncated": { "type": "integer" },
                "ranked": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["tool", "freshness", "window_secs", "last_seen_ts", "status", "acknowledged"],
                    "properties": {
                      "tool": { "type": "string" },
                      "freshness": { "type": "string", "enum": ["fresh", "stale", "unknown"] },
                      "age_secs": { "type": "integer" },
                      "window_secs": { "type": "integer" },
                      "last_seen_ts": { "type": "string" },
                      "status": { "type": "string" },
                      "acknowledged": { "type": "boolean" }
                    }
                  }
                }
              }
            }
          }
        },
        "wake_intent": {
          "type": ["object", "null"]
        },
        "room": {
          "type": "object"
        }
      }
    }
  }
}
