{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rally Install Command",
  "type": "object",
  "required": ["ok", "product", "command", "schema", "data"],
  "properties": {
    "ok": { "type": "boolean" },
    "product": { "const": "rally" },
    "command": { "const": "install" },
    "schema": { "const": "agent-rally.command.install.v1" },
    "data": {
      "type": "object",
      "required": ["target", "mode", "home", "rally_bin", "adapters"],
      "properties": {
        "target": { "type": "string" },
        "mode": { "type": "string" },
        "home": { "type": "string" },
        "rally_bin": { "type": "string" },
        "adapters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["adapter", "actions"],
            "properties": {
              "adapter": { "type": "string" },
              "actions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["path", "kind", "action", "executable", "owned"],
                  "properties": {
                    "path": { "type": "string" },
                    "kind": { "type": "string" },
                    "action": { "type": "string" },
                    "executable": { "type": "boolean" },
                    "owned": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
