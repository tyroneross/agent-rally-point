{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-rally-point.local/schemas/agent-rally.command.setup.v1.json",
  "title": "Rally setup command",
  "type": "object",
  "required": ["ok", "command", "schema", "channel", "data"],
  "properties": {
    "ok": { "const": true },
    "command": { "const": "setup" },
    "schema": { "const": "agent-rally.command.setup.v1" },
    "channel": { "type": "string" },
    "data": {
      "type": "object",
      "required": ["setup"],
      "properties": {
        "setup": {
          "type": "object",
          "required": ["schema", "enforcement", "tools", "startup"],
          "properties": {
            "schema": { "const": "agent-rally.command.setup.v1" },
            "enforcement": { "enum": ["off", "warn", "strict"] },
            "tools": { "type": "array", "items": { "type": "object" } },
            "startup": { "type": "array", "items": { "type": "string" } },
            "installed_path": { "type": ["string", "null"] }
          }
        }
      }
    }
  }
}
