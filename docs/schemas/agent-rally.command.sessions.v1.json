{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-rally:command:sessions:v1",
  "title": "Rally Sessions Command",
  "type": "object",
  "required": ["ok", "product", "command", "schema", "data"],
  "properties": {
    "ok": { "const": true },
    "product": { "const": "rally" },
    "command": { "const": "sessions" },
    "schema": { "const": "agent-rally.command.sessions.v1" },
    "data": {
      "type": "object",
      "required": ["sessions"],
      "properties": {
        "sessions": {
          "type": "object",
          "required": ["sessions"],
          "properties": {
            "sessions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "session_id",
                  "name",
                  "agent",
                  "tool",
                  "backend",
                  "cwd",
                  "target",
                  "liveness",
                  "liveness_source"
                ],
                "properties": {
                  "session_id": { "type": "string" },
                  "name": { "type": "string" },
                  "agent": { "type": "string" },
                  "tool": { "type": "string" },
                  "backend": { "type": "string" },
                  "task_scoped": {
                    "type": "boolean",
                    "description": "True for one-shot task processes; omitted for persistent interactive sessions."
                  },
                  "task_id": {
                    "type": "string",
                    "description": "Unique bounded-run id for the retained result artifact."
                  },
                  "cwd": { "type": "string" },
                  "target": { "type": "string" },
                  "worktree_path": { "type": "string" },
                  "branch": { "type": "string" },
                  "liveness": {
                    "enum": ["live", "stale", "unknown"]
                  },
                  "liveness_source": {
                    "enum": ["heartbeat_ttl", "backend_probe"]
                  },
                  "injectable": {
                    "type": "boolean",
                    "description": "True when rally inject can attempt a live managed-session transport for this session."
                  },
                  "inject_status": {
                    "type": "string",
                    "description": "Machine-readable injection readiness reason."
                  },
                  "inject_via": {
                    "type": "string",
                    "description": "Transport family used by rally inject for this managed session, for example tmux, cmux, or daemon."
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
