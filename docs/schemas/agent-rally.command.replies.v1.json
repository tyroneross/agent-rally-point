{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-rally:command:replies:v1",
  "title": "Rally Batch Reply Observations",
  "type": "object",
  "required": [
    "ok",
    "product",
    "command",
    "schema",
    "data"
  ],
  "properties": {
    "ok": {
      "const": true
    },
    "product": {
      "const": "rally"
    },
    "command": {
      "const": "replies"
    },
    "schema": {
      "const": "agent-rally.command.replies.v1"
    },
    "data": {
      "type": "object",
      "required": [
        "replies"
      ],
      "properties": {
        "replies": {
          "type": "object",
          "required": [
            "repo_root",
            "rows"
          ],
          "properties": {
            "repo_root": {
              "type": "string"
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "event_id",
                  "found",
                  "fact",
                  "reply",
                  "reply_fact",
                  "completion_status"
                ],
                "properties": {
                  "event_id": {
                    "type": "string"
                  },
                  "found": {
                    "type": "boolean"
                  },
                  "fact": {
                    "type": [
                      "object",
                      "null"
                    ]
                  },
                  "reply": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "description": "Present when the located fact is a handoff, a blocker, or an addressed requires-ack artifact. Uses the room projection's own closing rules.",
                    "required": [
                      "kind",
                      "state",
                      "history"
                    ],
                    "properties": {
                      "kind": {
                        "enum": [
                          "handoff",
                          "blocker",
                          "artifact"
                        ]
                      },
                      "state": {
                        "enum": [
                          "pending",
                          "acked",
                          "accepted",
                          "rejected",
                          "done",
                          "expired",
                          "open",
                          "resolved",
                          "answered",
                          "retracted"
                        ]
                      },
                      "to": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "by": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "at": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "reply_event_id": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "history": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": [
                            "state",
                            "at",
                            "event_id"
                          ],
                          "properties": {
                            "state": {
                              "type": "string"
                            },
                            "by": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "at": {
                              "type": "string"
                            },
                            "event_id": {
                              "type": "string"
                            }
                          }
                        }
                      },
                      "receiver_answered": {
                        "type": [
                          "boolean",
                          "null"
                        ],
                        "description": "Addressed items only: has the addressee answered (the rally inbox rule)? false while the item is still in the receiver's inbox, even if state is done."
                      }
                    }
                  },
                  "reply_fact": {
                    "type": [
                      "object",
                      "null"
                    ]
                  },
                  "completion_status": {
                    "enum": [
                      null,
                      "evidenced",
                      "resolved-unverified"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
