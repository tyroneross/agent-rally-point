{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-rally:command:inject:v1",
  "title": "Rally Inject Command",
  "type": "object",
  "required": ["ok", "product", "command", "schema", "data"],
  "properties": {
    "ok": { "const": true },
    "product": { "const": "rally" },
    "command": { "const": "inject" },
    "schema": { "const": "agent-rally.command.inject.v1" },
    "data": {
      "type": "object",
      "required": ["inject"],
      "properties": {
        "inject": {
          "type": "object",
          "required": [
            "mode",
            "session",
            "target_kind",
            "handoff",
            "require_ack",
            "ack",
            "verified_received",
            "ack_state",
            "fallback_plan",
            "wake_intent",
            "commands",
            "sender_tool",
            "content_fact",
            "delivered",
            "delivery_state",
            "directive_seq",
            "directive_to"
          ],
          "properties": {
            "mode": { "type": "string" },
            "session": { "type": ["object", "null"] },
            "target_kind": {
              "type": "string",
              "enum": ["managed_session", "ledger_agent"]
            },
            "handoff": { "type": ["string", "null"] },
            "require_ack": { "type": "boolean" },
            "ack": { "type": ["object", "null"] },
            "verified_received": { "type": "boolean" },
            "ack_state": {
              "type": "string",
              "enum": ["not_required", "planned", "acked", "blocked", "timeout", "pending"]
            },
            "fallback_plan": { "type": ["object", "null"] },
            "wake_intent": { "type": ["object", "null"] },
            "commands": { "type": "array" },
            "sender_tool": { "type": "string" },
            "content_fact": { "type": ["object", "null"] },
            "delivered": { "type": "boolean" },
            "delivery_state": { "type": "string" },
            "directive_seq": { "type": ["integer", "null"] },
            "directive_to": { "type": ["string", "null"] }
          }
        }
      }
    }
  }
}
