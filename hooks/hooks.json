{
  "$comment": "GENERATED from config/host-integrations.json. Claude plugin hooks are auto-loaded at this standard path. Project and plugin registration may both be active; the canonical hook counts registration sources for an identical event while preserving same-source repeats. Claude keeps edit-scoped PreToolUse while Codex intentionally checks every PreToolUse event.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "RALLY_HOOK_SOURCE=plugin \"${CLAUDE_PLUGIN_ROOT}/hooks/rally-coordination-hook.sh\" start claude_code",
            "timeout": 5000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "RALLY_HOOK_SOURCE=plugin \"${CLAUDE_PLUGIN_ROOT}/hooks/rally-coordination-hook.sh\" idle claude_code",
            "timeout": 5000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "RALLY_HOOK_SOURCE=plugin \"${CLAUDE_PLUGIN_ROOT}/hooks/rally-coordination-hook.sh\" before-write claude_code",
            "timeout": 10000
          }
        ],
        "matcher": "Edit|Write|MultiEdit|NotebookEdit"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "RALLY_HOOK_SOURCE=plugin \"${CLAUDE_PLUGIN_ROOT}/hooks/rally-coordination-hook.sh\" after-write claude_code",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
