{
  "name": "@tyroneross/rally-flow",
  "version": "0.1.0",
  "description": "Validate multi-agent workstream plans and derive the next tasks from Agent Rally Point records.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "workstream-lint": "./core/workstream-lint.mjs",
    "workstream-status": "./core/workstream-status.mjs"
  },
  "exports": {
    "./lint": "./core/workstream-lint.mjs",
    "./status": "./core/workstream-status.mjs",
    "./route": "./core/route.mjs",
    "./limiter": "./core/limiter.mjs",
    "./fanout": "./core/fanout.mjs"
  },
  "scripts": {
    "lint:example": "node core/workstream-lint.mjs examples/audit-repo.workstream.json",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "prepublishOnly": "npm test"
  },
  "files": [
    "core/",
    "examples/",
    "PROTOCOL.md",
    "COORDINATION.md",
    "MODEL-TIERS.md",
    "NOTICE",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {},
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tyroneross/agent-rally-point.git",
    "directory": "dynamic-workflows"
  },
  "homepage": "https://github.com/tyroneross/agent-rally-point/tree/main/dynamic-workflows#readme",
  "bugs": {
    "url": "https://github.com/tyroneross/agent-rally-point/issues"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
