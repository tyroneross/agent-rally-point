{
  "name": "dynamic-workflows",
  "version": "0.1.0",
  "description": "Rally Flow — Agent Rally Point's take on dynamic workflows: a portable workstream protocol + guardrail + host-facing skills + durable resume for coordinating multiple agents. Rally facilitates; hosts execute.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "workstream-lint": "./core/workstream-lint.mjs",
    "workstream-status": "./core/workstream-status.mjs"
  },
  "exports": {
    "./lint": "./core/workstream-lint.mjs",
    "./status": "./core/workstream-status.mjs",
    "./route": "./core/route.mjs",
    "./limiter": "./core/limiter.mjs"
  },
  "scripts": {
    "lint:example": "node core/workstream-lint.mjs examples/audit-repo.workstream.json",
    "test": "node --test \"tests/**/*.test.mjs\""
  },
  "files": [
    "core/",
    "skills/",
    "examples/",
    "PROTOCOL.md",
    "COORDINATION.md",
    "MODEL-TIERS.md",
    "NOTICE",
    "README.md"
  ],
  "dependencies": {}
}
