#!/bin/sh
# Local pre-push gate — replaces the ubuntu GitHub Actions rally-gate.
# Runs the same checks on the REAL runtime (this mac), under the pinned
# toolchain, so local == gate with zero cloud cost and no Linux/macOS mismatch.
# Blocks the push on failure. Emergency override: RALLY_SKIP_PREPUSH=1 git push
#
# Installed via `git config core.hooksPath .githooks` (versioned, survives clone,
# fires for agent pushes too). Keep in lockstep with rust-toolchain.toml.
set -e

if [ "${RALLY_SKIP_PREPUSH:-}" = "1" ]; then
  echo "pre-push: SKIPPED (RALLY_SKIP_PREPUSH=1)" >&2
  exit 0
fi

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# Pin to the same toolchain CI used, if available; else fall back to default.
TC="1.95.0"
if command -v rustup >/dev/null 2>&1 && rustup toolchain list 2>/dev/null | grep -q "^$TC"; then
  CARGO="rustup run $TC cargo"
else
  CARGO="cargo"
  echo "pre-push: toolchain $TC not found via rustup; using default cargo (fmt may differ)" >&2
fi

# fmt: scope to the .rs files actually being pushed. In a SHARED multi-agent
# checkout, a whole-tree `cargo fmt --check` would fail on another agent's
# uncommitted/untracked drift and block YOUR unrelated push. Checking only the
# pushed range keeps enforcement honest without that cross-agent coupling.
range="@{upstream}..HEAD"
git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' >/dev/null 2>&1 || range="HEAD"
changed_rs=$(git diff --name-only "$range" -- '*.rs' 2>/dev/null | { grep -E '\.rs$' || true; })
if [ -n "$changed_rs" ]; then
  echo "pre-push: format check (pushed .rs files)…" >&2
  # shellcheck disable=SC2086
  printf '%s\n' "$changed_rs" | while IFS= read -r f; do [ -f "$f" ] && rustfmt --edition 2024 --check "$f"; done
else
  echo "pre-push: no .rs changes in push range — fmt check skipped" >&2
fi

# clippy + test cover the compiled tree (a compile-break SHOULD block a push;
# use RALLY_SKIP_PREPUSH=1 for the rare intentional case).
echo "pre-push: clippy (-D warnings)…" >&2; $CARGO clippy --workspace --all-targets -- -D warnings
if command -v cargo-nextest >/dev/null 2>&1; then
  echo "pre-push: tests (cargo nextest)…" >&2
  $CARGO nextest run --workspace
  echo "pre-push: doctests…" >&2
  $CARGO test --workspace --doc
else
  echo "pre-push: cargo-nextest not installed; using serialized cargo test fallback" >&2
  echo "pre-push: install faster gate with: cargo install cargo-nextest --locked" >&2
  $CARGO test --workspace -- --test-threads=1
fi

# Supply-chain gates: only when dependencies actually changed (fast common path),
# and only if the tools are installed (fail-soft — a missing optional tool must
# not block a legitimate code push; note it instead).
dep_changed=0
if ! git diff --quiet "@{upstream}"..HEAD -- Cargo.lock Cargo.toml '**/Cargo.toml' deny.toml .cargo/audit.toml 2>/dev/null; then
  dep_changed=1
fi
if [ "$dep_changed" = "1" ]; then
  if command -v cargo-audit >/dev/null 2>&1; then
    echo "pre-push: deps changed — cargo audit…" >&2; cargo audit
  else
    echo "pre-push: deps changed but cargo-audit not installed — SKIPPED (install: cargo install cargo-audit)" >&2
  fi
  if command -v cargo-deny >/dev/null 2>&1; then
    echo "pre-push: deps changed — cargo deny…" >&2; cargo deny check --hide-inclusion-graph
  else
    echo "pre-push: deps changed but cargo-deny not installed — SKIPPED (install: cargo install cargo-deny)" >&2
  fi
fi

echo "pre-push: all gates green ✅" >&2
