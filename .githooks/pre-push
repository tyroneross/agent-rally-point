#
# Local pre-push gate — replaces the ubuntu GitHub Actions rally-gate.
#
# Validates the EXACT objects being pushed, not the current (possibly dirty,
# possibly ahead-of/behind-the-push) working tree: for every distinct
# non-deletion `local_sha` git is about to push (computed by
# scripts/prepush-ref-updates.sh from the ref-update tuples git supplies on
# stdin), this hook checks out a clean DETACHED worktree at that exact SHA
# and runs the shared quality gate (scripts/run-quality-gate.sh) inside it.
# Detached worktrees are always torn down via a trap — success, gate
# failure, or interrupt — so a blocked push never leaves stray worktrees.
#
# Blocks the push on failure. Emergency override: RALLY_SKIP_PREPUSH=1 git push
#
# Installed via `git config core.hooksPath .githooks` (versioned, survives
# clone, fires for agent pushes too). The actual gate steps (fmt/clippy/
# tests/doctests/audit) live in scripts/run-quality-gate.sh — ONE definition
# shared with CI (.github/workflows/ci.yml) so local and CI can never
# silently diverge. Keep the toolchain pin (RALLY_QG_TOOLCHAIN /
# rust-toolchain.toml) in lockstep across both.
set -e

if [ "${RALLY_SKIP_PREPUSH:-}" = "1" ]; then
  echo "pre-push: SKIPPED (RALLY_SKIP_PREPUSH=1)" >&2
  exit 0
fi

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# git supplies one "<local_ref> <local_sha> <remote_ref> <remote_sha>" tuple
# per line on stdin (see `git help githooks`, PRE-PUSH). Capture it once to a
# scratch file: scripts/prepush-ref-updates.sh needs to read it, and stdin
# can only be consumed once.
stdin_capture=$(mktemp "${TMPDIR:-/tmp}/rally-prepush-stdin.XXXXXX")
cat > "$stdin_capture"

sha_file=$(mktemp "${TMPDIR:-/tmp}/rally-prepush-shas.XXXXXX")
"$repo_root/scripts/prepush-ref-updates.sh" < "$stdin_capture" > "$sha_file"
rm -f "$stdin_capture"

if [ ! -s "$sha_file" ]; then
  echo "pre-push: no non-deletion refs to validate (pure deletion push, or empty ref-update list) — nothing to gate" >&2
  rm -f "$sha_file"
  exit 0
fi

worktree_base=$(mktemp -d "${TMPDIR:-/tmp}/rally-prepush-wt.XXXXXX")
cleanup() {
  # Runs on EVERY exit path (normal completion, a gate failure under `set -e`,
  # or an interrupt) — the single place worktrees get torn down, so a failed
  # push never leaves one behind.
  if [ -d "$worktree_base" ]; then
    for d in "$worktree_base"/*; do
      [ -d "$d" ] || continue
      git worktree remove --force "$d" >/dev/null 2>&1 || rm -rf "$d"
    done
    rm -rf "$worktree_base"
  fi
  git worktree prune >/dev/null 2>&1 || true
  rm -f "$sha_file"
}
trap cleanup EXIT INT TERM

while IFS= read -r sha; do
  [ -n "$sha" ] || continue
  wt="$worktree_base/$sha"
  echo "pre-push: $sha — creating clean detached worktree…" >&2
  git worktree add --detach "$wt" "$sha" >/dev/null
  echo "pre-push: $sha — running quality gate (scripts/run-quality-gate.sh)…" >&2
  ( cd "$wt" && ./scripts/run-quality-gate.sh )
  echo "pre-push: $sha — running release parity (scripts/check-release-parity.sh)…" >&2
  # f2: parity uses RALLY_CODEX_DEST (SEC-003) to regenerate the Codex
  # artifact into a scratch dir, so this never mutates the detached
  # worktree it runs in.
  ( cd "$wt" && ./scripts/check-release-parity.sh )
  echo "pre-push: $sha ✅ gate + parity passed" >&2
done < "$sha_file"

echo "pre-push: all gates green ✅" >&2
