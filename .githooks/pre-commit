#
# Local pre-commit gate — catches a bad author/committer identity BEFORE
# the commit object exists, which is far cheaper to fix than after: there is
# nothing to amend, nothing already pushed, no history to reason about — the
# operator just fixes `git config` and commits again.
#
# This is deliberately paired with .githooks/pre-push, which re-checks every
# unpushed commit (`scripts/check-git-identity.sh --commits HEAD --not
# --remotes=origin`) as a BACKSTOP for identities that never went through
# this hook: commits made in another clone, `git commit --no-verify`, an
# IDE's built-in commit UI, or another agent that bypasses this hooksPath.
# Do not rely on this hook alone.
#
# OPT-IN, same as .githooks/pre-push: this repo sets `core.hooksPath =
# .githooks`, so a file placed here is live for anyone who has opted into
# that per-clone setting — no separate installer step is needed for this
# file specifically.
#
# Emergency override (mirrors RALLY_SKIP_PREPUSH's idiom):
#   RALLY_SKIP_PRECOMMIT=1 git commit ...
set -e

if [ "${RALLY_SKIP_PRECOMMIT:-}" = "1" ]; then
  echo "pre-commit: SKIPPED (RALLY_SKIP_PRECOMMIT=1)" >&2
  exit 0
fi

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

exec scripts/check-git-identity.sh --pending
