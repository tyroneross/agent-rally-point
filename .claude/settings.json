{
  "$comment": "GENERATED from config/host-integrations.json. Portable project hooks work without global settings. Project and installed-plugin registration may overlap; the canonical hook counts registration sources for an identical event while preserving same-source repeats. Claude keeps edit-scoped PreToolUse while Codex intentionally checks every PreToolUse event. See docs/AUTO-COORDINATION-HOOKS.md.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "RALLY_HOOK_SOURCE=project \"${CLAUDE_PROJECT_DIR}/hooks/rally-coordination-hook.sh\" start claude_code",
            "timeout": 5000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "RALLY_HOOK_SOURCE=project \"${CLAUDE_PROJECT_DIR}/hooks/rally-coordination-hook.sh\" idle claude_code",
            "timeout": 5000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "RALLY_HOOK_SOURCE=project \"${CLAUDE_PROJECT_DIR}/hooks/rally-coordination-hook.sh\" before-write claude_code",
            "timeout": 10000
          }
        ],
        "matcher": "Edit|Write|MultiEdit|NotebookEdit"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "RALLY_HOOK_SOURCE=project \"${CLAUDE_PROJECT_DIR}/hooks/rally-coordination-hook.sh\" after-write claude_code",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
